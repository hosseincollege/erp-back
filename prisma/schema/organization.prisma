model Organization {
  id                 String                @id @default(cuid())
  installationId     String?
  name               String
  slug               String                @unique
  legalName          String?
  nationalId         String?
  registrationNumber String?
  economicCode       String?
  taxOffice          String?
  phone              String?
  email              String?
  website            String?
  address            String?
  postalCode         String?
  currency           String?               @default("IRR")
  fiscalYearStart    String?               @default("01-01")
  logoUrl            String?
  logoTone           String                @default("DARK")
  logoBackground     String                @default("NONE")
  status             OrganizationStatus    @default(ACTIVE)
  ownerId            String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  accountingInvoices AccountingInvoice[]
  auditLogs          AuditLog[]
  branches           Branch[]
  departments        Department[]
  departmentTeams    DepartmentTeam[]
  employees          Employee[]
  leaveRequests      LeaveRequest[]
  memberships        OrganizationMember[]
  settings           OrganizationSettings?
  installation       Installation?         @relation(fields: [installationId], references: [id])
  owner              User?                 @relation("OrganizationOwner", fields: [ownerId], references: [id])
  projects           Project[]
  roles              Role[]
  tickets            Ticket[]

  @@index([installationId])
  @@index([status])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime?
  invitedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  roles          MemberRole[]
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_members")
}

model Branch {
  id                 String              @id @default(cuid())
  organizationId     String
  name               String
  code               String
  address            String?
  phone              String?
  email              String?             // فیلد جدید
  postalCode         String?             // فیلد جدید
  isMain             Boolean             @default(false) // فیلد جدید
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accountingInvoices AccountingInvoice[]
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments        Department[]
  employees          Employee[]

  @@unique([organizationId, code])      // یکتایی کد در سطح هر سازمان
  @@index([organizationId])
  @@map("branches")
}

model Department {
  id                 String              @id @default(cuid())
  organizationId     String
  branchId           String?
  name               String
  code               String
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accountingInvoices AccountingInvoice[]
  branch             Branch?             @relation(fields: [branchId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees          Employee[]
  managerEmployeeId  String?
  manager            Employee?           @relation("DepartmentManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  teams              DepartmentTeam[]

  @@unique([organizationId, code])      // یکتایی کد در سطح هر سازمان
  @@index([organizationId])
  @@index([branchId])
  @@index([managerEmployeeId])
  @@map("departments")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}
