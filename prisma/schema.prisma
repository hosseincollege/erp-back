// File: backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DeploymentMode {
  CLOUD
  ON_PREMISE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum RoleScope {
  SYSTEM
  ORGANIZATION
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  SUPPORT
  INCIDENT
  REQUEST
  QUESTION
  COMPLAINT
}

enum TicketVisibility {
  INTERNAL
  CUSTOMER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVITE
  ACTIVATE
  DISABLE
  PASSWORD_RESET
}

model Installation {
  id                    String         @id @default(cuid())
  name                  String?
  deploymentMode        DeploymentMode @default(ON_PREMISE)
  initialSetupCompleted Boolean        @default(false)
  publicRegistration    Boolean        @default(false)
  demoEnabled           Boolean        @default(false)
  requireActivationCode Boolean        @default(true)
  timezone              String         @default("Asia/Tehran")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organizations   Organization[]
  activationCodes ActivationCode[]

  @@index([deploymentMode])
  @@map("installations")
}

model Organization {
  id             String        @id @default(cuid())
  installationId String?
  installation   Installation? @relation(fields: [installationId], references: [id], onDelete: SetNull)

  name       String
  slug       String             @unique
  legalName  String?
  nationalId String?
  phone      String?
  email      String?
  address    String?
  logoUrl    String?
  status     OrganizationStatus @default(ACTIVE)

  ownerId String?
  owner   User?   @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
  tickets     Ticket[]
  auditLogs   AuditLog[]
  roles       Role[]

  @@index([installationId])
  @@index([status])
  @@map("organizations")
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  email        String?    @unique
  phone        String?    @unique
  firstName    String
  lastName     String
  passwordHash String
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  isSystemUser Boolean    @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ownedOrganizations Organization[]       @relation("OrganizationOwner")
  memberships        OrganizationMember[]
  createdTickets     Ticket[]             @relation("TicketCreator")
  assignedTickets    Ticket[]             @relation("TicketAssignee")
  ticketMessages     TicketMessage[]
  auditLogs          AuditLog[]
  createdCodes       ActivationCode[]     @relation("ActivationCodeCreator")

  @@index([status])
  @@index([lastLoginAt])
  @@map("users")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime?
  invitedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  roles MemberRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_members")
}

model Role {
  id             String    @id @default(cuid())
  name           String
  key            String
  description    String?
  scope          RoleScope @default(ORGANIZATION)
  isSystemRole   Boolean   @default(false)
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  members     MemberRole[]

  @@unique([key, organizationId])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MemberRole {
  memberId String
  roleId   String

  member OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@map("member_roles")
}

model ActivationCode {
  id             String    @id @default(cuid())
  codeHash       String    @unique
  type           String
  organizationId String?
  installationId String?
  createdById    String?
  expiresAt      DateTime?
  usedAt         DateTime?
  maxUses        Int       @default(1)
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  installation Installation? @relation(fields: [installationId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("ActivationCodeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([installationId])
  @@index([organizationId])
  @@index([type, isActive])
  @@map("activation_codes")
}

model Ticket {
  id             String  @id @default(cuid())
  organizationId String?
  creatorId      String
  assigneeId     String?

  ticketNumber Int
  subject      String
  description  String
  type         TicketType       @default(SUPPORT)
  status       TicketStatus     @default(OPEN)
  priority     TicketPriority   @default(MEDIUM)
  visibility   TicketVisibility @default(INTERNAL)
  category     String?
  dueAt        DateTime?
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  creator      User          @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee     User?         @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  messages TicketMessage[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([createdAt])
  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("ticket_messages")
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String?
  userId         String?
  action         AuditAction
  entity         String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
